{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "importHelpers": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true,
    "lib": ["ESNext", "dom", "dom.iterable", "es2019", "WebWorker"],
    "paths": {
      "@codeimage/store/*": ["./src/state/*"],
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": ["./src/**/*", "./scripts/**/*"]
}
