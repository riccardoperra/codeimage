{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "importHelpers": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "lib": ["ESNext", "dom", "dom.iterable", "es2019", "WebWorker"],
    "paths": {
      "@codeimage/store/*": ["./src/state/*"],
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"],
      "virtual:codeimage-solid2-islands": [
        "./src/pages/UnifiedEditor/solid2-islands.d.ts"
      ]
    }
  },
  "include": ["./src/**/*", "./scripts/**/*"]
}
