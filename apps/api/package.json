{
  "name": "@codeimage/api",
  "version": "0.7.0",
  "description": "CodeImage api rest server",
  "main": "app.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "exports": {
    "./api-types": {
      "types": "./src/api-types.ts",
      "default": "./api-types/index.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:unit": "RUN_TEST=unit vitest run",
    "test:integration": "RUN_TEST=integration vitest run --no-file-parallelism",
    "test:ui": "vitest --ui",
    "lint": "node ../../scripts/lint.mjs",
    "lint:fix": "oxlint --fix",
    "pre-commit-format": "oxfmt",
    "pre-commit-eslint": "oxlint --fix",
    "start:railway": "fastify start --options --address='0.0.0.0' -l info dist/app.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.test.json",
    "typecheck:ci": "tsc --skipLibCheck --project tsconfig.dts.json",
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build:ts": "tsdown",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:test": "dotenv-cli -e .env.test -- prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy-test": "dotenv-cli -e .env.test -- prisma migrate deploy",
    "prisma:migrate:reset-test": "dotenv-cli -e .env.test -- prisma migrate reset --force",
    "prisma:generate": "prisma generate dev && pnpm --filter=@codeimage/prisma-models build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "test:architecture:rules": "tsx scripts/verify-architecture.ts",
    "test:built": "dotenv-cli -e .env.test -- node scripts/smoke-built.ts",
    "test:built:cli": "dotenv-cli -e .env.test -- node scripts/smoke-cli.mjs"
  },
  "keywords": [],
  "author": "Riccardo Perra",
  "license": "ISC",
  "dependencies": {
    "@codeimage/prisma-models": "workspace:*",
    "@fastify/autoload": "6.5.1",
    "@fastify/cors": "11.4.3",
    "@fastify/env": "7.0.1",
    "@fastify/jwt": "10.2.7",
    "@fastify/swagger": "9.9.4",
    "@fastify/swagger-ui": "6.1.4",
    "@fastify/type-provider-typebox": "6.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "0.34.52",
    "close-with-grace": "^2.5.0",
    "dotenv": "18.0.10",
    "dotenv-cli": "11.1.0",
    "fastify": "5.12.8",
    "fastify-auth0-verify": "4.1.4",
    "fastify-cli": "8.0.3",
    "fastify-healthcheck": "^5.1.0",
    "fastify-plugin": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:next",
    "@vitest/ui": "4.1.12",
    "fastify-tsconfig": "^3.0.0",
    "oxfmt": "catalog:next",
    "oxlint": "catalog:next",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsdown": "catalog:next",
    "tsx": "catalog:next",
    "typescript": "catalog:next",
    "vite": "catalog:next",
    "vitest": "catalog:next"
  }
}
